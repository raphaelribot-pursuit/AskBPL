# Ask BPL pilot — copy to `.env` and fill in values. Never commit real secrets.

# PostgreSQL (docker-compose default matches these)
DATABASE_URL=postgresql+asyncpg://askbpl:askbpl_dev_password@localhost:5434/askbpl

# JWT (required — app refuses to start without a non-empty secret)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256

# Pilot demo tester (seed + local sign-in — never commit real production codes)
PILOT_DEMO_EMAIL=pilot-demo@bklynlibrary.org
PILOT_DEMO_ACCESS_CODE=
SEED_AUTO_APPROVE_ROUTING=1

# OpenAI embeddings
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Pinecone (set PINECONE_HOST for serverless — from Pinecone console index details)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=askbpl-pilot
# Optional: e.g. https://your-index-xxxxx.svc.<region>.pinecone.io
PINECONE_HOST=

# Anthropic Claude (BPL-provided key in production)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Retrieval / generation tuning
PINECONE_TOP_K=6
# Grounding threshold — minimum cosine similarity for retrieval.
# 0.40 tuned for text-embedding-3-small with pilot corpus.
# Raise to reduce false positives; lower to reduce false refusals.
GROUNDING_THRESHOLD=0.40

# Orchestrator binding
HOST=0.0.0.0
PORT=8000

# Admin console Basic Auth (build team — set a non-empty password for /admin and integration tests)
ADMIN_BASIC_USER=vizion_build
ADMIN_BASIC_PASSWORD=

# CORS origins (comma-separated) for modal SPA — include production Vercel URL on Render
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://askbpl-web-demo.vercel.app

# Web demo (Vite) — optional prefill for local sign-in only
VITE_PILOT_DEMO_EMAIL=pilot-demo@bklynlibrary.org
VITE_PILOT_DEMO_DISPLAY_NAME=Lee Aulder
VITE_PILOT_DEMO_ACCESS_CODE=

# Ingest: scanned PDF OCR (optional pip extra `.[ocr]` + system tesseract + poppler)
# OCR_ENABLED=false uses pypdf only (e.g. CI without native deps).
# OCR_DPI=300
# OCR_MIN_CHARS_PER_PAGE=100

# Corpus files directory for ingest CLI
CORPUS_DIR=./sample_corpus

# Public base URL for document links in citations (optional)
DOCUMENTS_PUBLIC_BASE_URL=
